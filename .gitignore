# =============================================================================
# Ai_Studio_Flutter — workspace root .gitignore
# 与 apps/*、packages/* 内 Flutter 默认 .gitignore 互补；根级兜底全仓。
# =============================================================================

# ----- IDE / 编辑器 -----
.idea/
*.iml
*.ipr
*.iws
*.swp
*.swo
*~
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace
# .vscode/ 默认纳入版本控制（可共享 launch/tasks）；仅忽略本机态
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/*.code-snippets

# ----- 操作系统 -----
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# ----- Dart / Flutter / Pub（workspace 全仓） -----
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
**/doc/api/
**/ios/Flutter/.last_build_id
build/
coverage/
.melos_tool/
.fvm/
.fvmrc

# Symbolication / Obfuscation
app.*.symbols
app.*.map.json

# ----- Android 本地与签名（根级兜底；平台目录内亦有规则） -----
**/local.properties
**/key.properties
**/*.keystore
**/*.jks
*.apk
*.aab
*.ap_
*.dex

# ----- iOS / macOS / Xcode（根级兜底） -----
**/Pods/
**/DerivedData/
**/*.xcuserstate
**/xcuserdata/
**/*.moved-aside
**/*.hmap
**/*.ipa
**/*.dSYM.zip
**/*.dSYM
**/Flutter/ephemeral/
**/Flutter/Generated.xcconfig
**/Flutter/flutter_export_environment.sh
**/ServiceDefinitions.json

# ----- Windows / Visual Studio -----
*.suo
*.user
*.userosscache
*.sln.docstates
**/windows/flutter/ephemeral/

# ----- 密钥 / 本地配置 / 环境变量 -----
.env
.env.*
!.env.example
!.env.*.example
*.pem
*.p12
*.pfx
secrets/
**/secrets.json
**/credentials.json
**/google-services.json
**/GoogleService-Info.plist

# ----- 日志与临时文件 -----
*.log
*.tmp
*.temp
*.bak
*.orig
*.class
*.pyc
__pycache__/
.cache/
.history
.atom/
.build/
.buildlog/
.svn/
.swiftpm/
migrate_working_dir/

# ----- 测试 / 覆盖率 / 杂项生成物 -----
.test_coverage.dart
coverage_badge.svg
*.lcov

# ----- 本机工具缓存（按需） -----
.opencode/
.cursor/
.claude/
