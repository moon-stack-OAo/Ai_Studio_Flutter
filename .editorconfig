# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.{dart,yaml,yml,json,xml,html,css,js,mjs,ts,kt,kts,swift,cmake,gradle,properties,plist,xcconfig,pbxproj,iss,ps1,sh}]
end_of_line = lf

[*.{bat,cmd}]
end_of_line = crlf

[*.{sln,csproj}]
end_of_line = crlf
